CONFIG_PATH=/auth-service/configs/config.yaml # config path in current project

ENV=local # local/dev/prod

JWT_SECRET=your_jwt_secret # set your own jwt secret key

POSTGRES_PASSWORD=your_admin_password_here
POSTGRES_HOST=your_database_container_name
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_DB=auth-service-db
POSTGRES_SSLMODE=disable

CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Requested-With
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_EXPOSE_HEADERS=Content-Length,X-Request-ID
CORS_ALLOWED_METHODS=GET,POST,DELETE,OPTIONS
CORS_MAX_AGE=60

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback

COOKIE_SECURE=false

INTEGRATION=0 # set INTEGRATION=1 to run integration tests
BENCHMARK=0 # set BENCHMARK=1 to run benchmark tests